model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DimProduct","DimCustomer","DimTerritory","Fact_Sales","Fact_ProductInventory","DimLocation"]

ref table DimProduct
ref table DimCustomer
ref table DimTerritory
ref table Fact_Sales
ref table Fact_ProductInventory
ref table Calendar
ref table DimLocation
ref table Lang

ref cultureInfo en-US

