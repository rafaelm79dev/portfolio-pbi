{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.8.0/schema.json",
  "name": "chart_inventory_location",
  "position": {
    "x": 815,
    "y": 505,
    "z": 7,
    "height": 210,
    "width": 445,
    "tabOrder": 7
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimLocation"
                    }
                  },
                  "Property": "LocationName"
                }
              },
              "queryRef": "DimLocation.LocationName",
              "nativeQueryRef": "LocationName",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_ProductInventory"
                    }
                  },
                  "Property": "Total Inventory"
                }
              },
              "queryRef": "Fact_ProductInventory.Total Inventory",
              "nativeQueryRef": "Total Inventory"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Lang"
                    }
                  },
                  "Property": "Title Inventory Location"
                }
              }
            },
            "alignment": {
              "expr": {
                "Literal": {
                  "Value": "'left'"
                }
              }
            },
            "bold": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "11D"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#6B7280'"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "border": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#E5E7EB'"
                    }
                  }
                }
              }
            },
            "radius": {
              "expr": {
                "Literal": {
                  "Value": "8D"
                }
              }
            }
          }
        }
      ],
      "background": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#FFFFFF'"
                    }
                  }
                }
              }
            },
            "transparency": {
              "expr": {
                "Literal": {
                  "Value": "0D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "categoryAxis": [
        {
          "properties": {
            "labelColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#6B7280'"
                    }
                  }
                }
              }
            },
            "axisColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#D1D5DB'"
                    }
                  }
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "10D"
                }
              }
            }
          }
        }
      ],
      "valueAxis": [
        {
          "properties": {
