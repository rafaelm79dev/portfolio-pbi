              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "dataPoint": [
        {
          "properties": {
            "defaultColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#D97706'"
                    }
                  }
                }
              }
            },
            "showAllDataPoints": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
